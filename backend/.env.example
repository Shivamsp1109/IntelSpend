PORT=3000

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=spendwise

# Option 1: path to Firebase Admin service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option 2: base64 of Firebase Admin service account JSON.
# Use this on hosting providers where file upload is inconvenient.
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# ─── Smart extraction (POST /extract) ────────────────────────────────────────
# Required only if you enable smart extraction in the app. Without it the
# endpoint returns 503 and the app falls back to on-device parsing.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Every image is tried on this model first. Flash-Lite is the cheapest tier
# supporting vision + structured output (~₹0.05 per import).
#
# MUST be a 3.x model. The 2.5-series is closed to new API keys — those models
# still appear in the /models listing but return 404 "no longer available to new
# users" when you actually call generateContent.
GEMINI_MODEL=gemini-3.1-flash-lite

# Retried on this model when the cheap one reports low confidence or reads
# nothing — typically a blurry photo, faded thermal receipt, or dense statement.
# An escalated image is billed TWICE (~₹0.05 + ~₹0.15). Set to an empty value
# to disable escalation and stay on the cheap model always.
GEMINI_FALLBACK_MODEL=gemini-3-flash

# Escalate when the cheap model's lowest per-transaction confidence falls below
# this. Raise it to catch more bad reads (costs more), lower it to escalate less.
EXTRACT_ESCALATE_BELOW=0.7

# Hard ceiling on extraction calls per user per calendar month. A runaway
# client loop cannot run up an unbounded bill; the user gets a clear 429.
EXTRACT_MONTHLY_CAP=500

# Fallback per-MTok rates for cost estimates in the llm_usage table. Rates for
# the 3.x Flash / Flash-Lite models are built in and looked up per attempt;
# these only apply to a model the server doesn't recognise.
EXTRACT_INPUT_COST_PER_MTOK=0.25
EXTRACT_OUTPUT_COST_PER_MTOK=1.50
