PORT=3000

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=spendwise

# TLS to the database. Off by default because the usual local setup keeps MySQL
# on the same machine, where the connection never touches a network.
#
# Set this to true the moment the database is anywhere else — a managed
# instance, another container, another host. Without it every transaction, and
# every user's email address, crosses that network in the clear.
# MYSQL_SSL=true
#
# Path to the provider's CA bundle, if they issue one. Without it the driver
# still encrypts but cannot verify who it is talking to: that stops passive
# sniffing, not an active man in the middle.
# MYSQL_SSL_CA=./mysql-ca.pem

# ─── Serving ─────────────────────────────────────────────────────────────────
# Browser origins allowed to call this API. Empty means none, which is right
# while the only client is the Android app — it is not a browser and is not
# subject to CORS.
# ALLOWED_ORIGINS=https://app.example.com

# How many proxies sit in front of this server. Leave unset when it is exposed
# directly.
#
# Set it when deploying behind Nginx, a load balancer or a platform router, or
# the IP-based rate limiting reads the proxy's address for everyone and stops
# limiting anything. Setting it too high is worse: the server starts trusting
# an X-Forwarded-For header a client can write itself, and any caller can claim
# any address. The value is the number of hops you actually control.
# TRUST_PROXY=1

# ─── Rate limits ─────────────────────────────────────────────────────────────
# Defaults suit a personal deployment; all are per 15 minutes except the model
# limit, which is per minute.
#
# Pre-auth and keyed by IP. Only guards the cost of verifying tokens, so it is
# deliberately loose.
# RATE_LIMIT_PUBLIC_MAX=600
#
# Ordinary sync, keyed by user. Generous because a first import pushes a few
# hundred rows in a burst.
# RATE_LIMIT_SYNC_MAX=400
#
# Model-backed routes, keyed by user, per minute. EXTRACT_MONTHLY_CAP below
# bounds the monthly bill; this bounds how fast it can be spent, so a client
# stuck retrying cannot burn the month's allowance in a couple of minutes.
# RATE_LIMIT_MODEL_MAX=12

# Option 1: path to Firebase Admin service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option 2: base64 of Firebase Admin service account JSON.
# Use this on hosting providers where file upload is inconvenient.
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# ─── Smart extraction (POST /extract) ────────────────────────────────────────
# Required only if you enable smart extraction in the app. Without it the
# endpoint returns 503 and the app falls back to on-device parsing.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Every image is tried on this model first. Flash-Lite is the cheapest tier
# supporting vision + structured output (~₹0.05 per import).
#
# MUST be a 3.x model. The 2.5-series is closed to new API keys — those models
# still appear in the /models listing but return 404 "no longer available to new
# users" when you actually call generateContent.
GEMINI_MODEL=gemini-3.1-flash-lite

# Retried on this model when the cheap one reports low confidence or reads
# nothing — typically a blurry photo, faded thermal receipt, or dense statement.
# An escalated image is billed TWICE (~₹0.05 + ~₹0.15). Set to an empty value
# to disable escalation and stay on the cheap model always.
GEMINI_FALLBACK_MODEL=gemini-3-flash

# Escalate when the cheap model's lowest per-transaction confidence falls below
# this. Raise it to catch more bad reads (costs more), lower it to escalate less.
EXTRACT_ESCALATE_BELOW=0.7

# Hard ceiling on extraction calls per user per calendar month. A runaway
# client loop cannot run up an unbounded bill; the user gets a clear 429.
EXTRACT_MONTHLY_CAP=500

# Fallback per-MTok rates for cost estimates in the llm_usage table. Rates for
# the 3.x Flash / Flash-Lite models are built in and looked up per attempt;
# these only apply to a model the server doesn't recognise.
EXTRACT_INPUT_COST_PER_MTOK=0.25
EXTRACT_OUTPUT_COST_PER_MTOK=1.50

# ─── Financial engine ────────────────────────────────────────────────────────
# How long a decision trace is kept before the scheduled purge removes it.
#
# A trace records the question a user asked and the figures the engine reasoned
# over to answer it — useful for explaining a recommendation and for finding an
# engine defect, and exactly the kind of record that should not accumulate
# indefinitely. Long enough to investigate a complaint about an answer given
# last quarter; not so long that the store becomes a permanent archive of what
# everyone asked about their money.
#
# A user can delete an individual trace at any time regardless of this setting;
# that path redacts the question and payload rather than dropping the row, so
# the fact that a recommendation was made stays auditable while its contents do
# not survive.
DECISION_TRACE_RETENTION_DAYS=180
