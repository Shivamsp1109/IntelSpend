<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only networking policy.

    Overlays the release config so `./gradlew installDebug` can still talk to a
    backend running on your laptop over plain HTTP. Cleartext stays denied
    everywhere else, and this file is never packaged into a release build —
    resource overlays are per build type, so there is no flag anyone can flip to
    carry it across.

    Add hosts here as needed for development; keep the list to machines you
    control.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <!-- Lets a proxy like Charles or mitmproxy inspect debug traffic. -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">192.168.1.19</domain>
    </domain-config>
</network-security-config>
